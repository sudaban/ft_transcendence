DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=database
DB_PORT=5432
DB_NAME=transcendence

ASPNETCORE_ENV=Development
ASPNETCORE_URLS=http://+:5000

# Nginx host ports (rootless Docker cannot bind ports < 1024, e.g. on 42 PCs)
HTTP_PORT=8080
HTTPS_PORT=8443

PUBLIC_API_URL=https://localhost:8443/api

JWT_SECRET_KEY=change-me-to-a-long-random-secret

# OAuth 2.0 Client Credentials
OAUTH_INTRA_CLIENT_ID=default-42-client-id
OAUTH_INTRA_CLIENT_SECRET=default-42-client-secret
OAUTH_GOOGLE_CLIENT_ID=default-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=default-google-client-secret

# Admin Credentials
ADMIN_EMAIL=admin42@gmail.com
ADMIN_PASSWORD=aşiret42